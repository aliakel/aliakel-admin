{
    "name": ":package",
    "description": "AliAkel Admin extension",
    "type": "library",
    "keywords": ["aliakel-admin", "laravel", "admin", "extension"],
    "homepage": "https://github.com/:package",
    "license": "MIT",
    "authors": [
        {
            "name": "Eng.Ali Akel",
            "email": "aliakel1991@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "aliakel/aliakel-admin": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            ":namespace": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                ":namespace:class_nameServiceProvider"
            ]
        }
    }
}
